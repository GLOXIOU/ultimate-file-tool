{
  "name": "ultimate-file-tool",
  "productName": "Ultimate File Tool",
  "version": "0.2.0",
  "description": "All-in-one offline desktop toolbox for images, video, audio, PDF, documents, data, archives and more.",
  "main": "main.js",
  "author": "GLOXIOU",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.gloxiou.ultimatefiletool",
    "productName": "Ultimate File Tool",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "lib/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/7zip-bin/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "archiver": "^5.3.2",
    "chardet": "^2.2.0",
    "exif-reader": "^2.0.3",
    "extract-zip": "^2.0.1",
    "fast-xml-parser": "^5.12.0",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "html-to-docx": "^1.8.0",
    "iconv-lite": "^0.7.3",
    "js-yaml": "^5.5.0",
    "jsqr": "^1.4.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "tar": "^7.5.22",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
